{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/moq/common.v1.schema.json",
  "title": "MoQ common definitions v1",
  "$defs": {
    "contractVersion": {"type": "integer", "const": 1},
    "tenantId": {"type": "string", "pattern": "^tn_[A-Za-z0-9_-]{16,64}$"},
    "programId": {"type": "string", "pattern": "^prg_[A-Za-z0-9_-]{16,64}$"},
    "audienceId": {"type": "string", "pattern": "^aud_[A-Za-z0-9_-]{16,64}$"},
    "participantRef": {"type": "string", "pattern": "^(brw|gtw|prv)_[A-Za-z0-9_-]{16,64}$"},
    "renditionId": {"type": "string", "pattern": "^ren_[A-Za-z0-9_-]{16,64}$"},
    "epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "timestamp": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "namespace": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^tn_[A-Za-z0-9_-]{16,64}/prg_[A-Za-z0-9_-]{16,64}/epoch/[1-9][0-9]{0,15}$"},
    "trackName": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
    "codec": {"enum": ["opus", "aac", "vp8", "vp9", "h264", "av1"]},
    "priority": {"type": "integer", "minimum": 0, "maximum": 255},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "moqtVersion": {"enum": ["draft-ietf-moq-transport-14", "draft-ietf-moq-transport-16", "draft-ietf-moq-transport-18", "draft-ietf-moq-transport-19", "draft-ietf-moq-transport-20"]},
    "locVersion": {"enum": ["draft-ietf-moq-loc-03", "draft-ietf-moq-loc-04"]},
    "webTransportVersion": {"enum": ["RFC 9297"]},
    "secureObjectsVersion": {"enum": ["draft-ietf-moq-secure-objects-01"]},
    "extension": {"enum": ["loc-header-v04", "secure-object-v01"]},
    "fallbackProtocol": {"enum": ["ll-hls", "hls"]}
  }
}
