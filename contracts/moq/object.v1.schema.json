{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/moq/object.v1.schema.json",
  "title": "MoQ object metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "type", "tenantId", "programId", "programEpoch", "audienceId", "namespace", "trackName", "groupId", "objectId", "priority", "status", "payloadBytes", "payloadSha256", "expiresAt"],
  "properties": {
    "contractVersion": {"$ref": "common.v1.schema.json#/$defs/contractVersion"},
    "type": {"const": "moq-object"},
    "tenantId": {"$ref": "common.v1.schema.json#/$defs/tenantId"},
    "programId": {"$ref": "common.v1.schema.json#/$defs/programId"},
    "programEpoch": {"$ref": "common.v1.schema.json#/$defs/epoch"},
    "audienceId": {"$ref": "common.v1.schema.json#/$defs/audienceId"},
    "namespace": {"$ref": "common.v1.schema.json#/$defs/namespace"},
    "trackName": {"$ref": "common.v1.schema.json#/$defs/trackName"},
    "groupId": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "objectId": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "priority": {"$ref": "common.v1.schema.json#/$defs/priority"},
    "status": {"enum": ["normal", "end-of-group", "end-of-track"]},
    "payloadBytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
    "payloadSha256": {"$ref": "common.v1.schema.json#/$defs/sha256"},
    "expiresAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"}
  }
}
