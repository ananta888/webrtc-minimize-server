{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/media-agent/agent-authentication.v2.schema.json",
  "title": "P-256 native media-agent authentication v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "agentId", "timestamp", "proof"],
  "properties": {
    "version": { "const": 2 },
    "type": { "const": "authenticate" },
    "agentId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "timestamp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "proof": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
  }
}
