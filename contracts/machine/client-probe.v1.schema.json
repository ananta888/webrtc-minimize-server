{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ananta.meet-client-probe.v1",
  "title": "Read-only isolated browser feasibility, never a grant or capture",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "client", "frameEnvelope", "nativeAdapter", "secureContext", "encodedTransform", "codecs", "ports"],
  "properties": {
    "schema": { "const": "ananta.meet-client-probe.v1" },
    "client": { "const": "isolated-browser-v1" },
    "frameEnvelope": { "const": "codec-prefix-v1" },
    "nativeAdapter": { "const": false },
    "secureContext": { "type": "boolean" },
    "encodedTransform": { "type": "boolean" },
    "codecs": {
      "type": "object", "additionalProperties": false,
      "required": ["vp8Send", "vp8Receive", "opusSend", "opusReceive"],
      "properties": {
        "vp8Send": { "type": "boolean" }, "vp8Receive": { "type": "boolean" },
        "opusSend": { "type": "boolean" }, "opusReceive": { "type": "boolean" }
      }
    },
    "ports": {
      "type": "object", "additionalProperties": false,
      "required": ["session", "mp4", "chat", "audio", "visual", "screen", "screenAudio", "speech", "avatar"],
      "properties": {
        "session": { "type": "boolean" }, "mp4": { "type": "boolean" }, "chat": { "type": "boolean" },
        "audio": { "type": "boolean" }, "visual": { "type": "boolean" }, "screen": { "type": "boolean" },
        "screenAudio": { "type": "boolean" }, "speech": { "type": "boolean" }, "avatar": { "type": "boolean" }
      }
    }
  }
}
