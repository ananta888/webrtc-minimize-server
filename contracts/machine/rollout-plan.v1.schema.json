{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ananta.meet-rollout-plan.v1",
  "title": "Local rollout expectation, never operator authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "meetRevision", "hubRevision", "publicOrigin", "hubIssuer", "hubKeySha256", "tenantId", "projectId", "roomId", "capabilities"],
  "properties": {
    "schema": { "const": "ananta.meet-rollout-plan.v1" },
    "meetRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "hubRevision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "publicOrigin": { "type": "string", "pattern": "^https://[^/]+$" },
    "hubIssuer": { "type": "string", "minLength": 8, "maxLength": 160 },
    "hubKeySha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tenantId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$" },
    "projectId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,160}$" },
    "roomId": { "type": "string", "pattern": "^room-[a-f0-9]{18}$" },
    "capabilities": {
      "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true,
      "items": { "enum": ["audio.receive", "avatar.publish", "chat.read", "chat.send", "screen-audio.publish", "screen.publish", "speech.publish", "video.receive"] }
    }
  }
}
