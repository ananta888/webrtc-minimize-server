{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/native-packager/source-audio-applied.v1.schema.json",
  "title": "Native audio presentation control; current authenticated owner and explicit director authority required",
  "$comment": "Runtime additionally enforces 16 KiB, freshness, unique sourceLeaseId, current scope, source consent and CAS. A receipt is historical, not renewed authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "commandId",
    "assignmentId",
    "programId",
    "programEpoch",
    "leaseId",
    "fencingRevision",
    "audioRevision",
    "appliedAt"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "const": "source-program-audio-applied"
    },
    "commandId": {
      "type": "string",
      "pattern": "^aud_[A-Za-z0-9_-]{16,64}$"
    },
    "assignmentId": {
      "type": "string",
      "pattern": "^asn_[A-Za-z0-9_-]{16,64}$"
    },
    "programId": {
      "type": "string",
      "pattern": "^prg_[A-Za-z0-9_-]{16,64}$"
    },
    "programEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "leaseId": {
      "type": "string",
      "pattern": "^lea_[A-Za-z0-9_-]{16,64}$"
    },
    "fencingRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "audioRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "appliedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
