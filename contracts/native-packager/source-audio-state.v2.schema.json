{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/native-packager/source-audio-state.v2.schema.json",
  "title": "Native audio presentation control; current authenticated owner and explicit director authority required",
  "$comment": "Runtime additionally enforces 16 KiB, freshness, unique sourceLeaseId, current scope, source consent and CAS. A receipt is historical, not renewed authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "commandId",
    "assignmentId",
    "programId",
    "programEpoch",
    "leaseId",
    "fencingRevision",
    "audioRevision",
    "observedAt",
    "sources",
    "mix",
    "encoding"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "type": {
      "const": "source-program-audio-state"
    },
    "commandId": {
      "type": "string",
      "pattern": "^aud_[A-Za-z0-9_-]{16,64}$"
    },
    "assignmentId": {
      "type": "string",
      "pattern": "^asn_[A-Za-z0-9_-]{16,64}$"
    },
    "programId": {
      "type": "string",
      "pattern": "^prg_[A-Za-z0-9_-]{16,64}$"
    },
    "programEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "leaseId": {
      "type": "string",
      "pattern": "^lea_[A-Za-z0-9_-]{16,64}$"
    },
    "fencingRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "audioRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sources": {
      "type": "array",
      "maxItems": 80,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceLeaseId",
          "leftGainQ15",
          "rightGainQ15",
          "muted",
          "sourceKind"
        ],
        "properties": {
          "sourceLeaseId": {
            "type": "string",
            "pattern": "^sls_[A-Za-z0-9_-]{16,64}$"
          },
          "leftGainQ15": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32768
          },
          "rightGainQ15": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32768
          },
          "muted": {
            "type": "boolean"
          },
          "sourceKind": {
            "enum": [
              "microphone",
              "screen-audio"
            ]
          }
        }
      }
    },
    "mix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "microphoneGainQ15",
        "screenAudioGainQ15",
        "limiterGainQ15",
        "peakQ15"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "unprocessed",
            "balanced",
            "speech-first",
            "screen-first"
          ]
        },
        "microphoneGainQ15": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "screenAudioGainQ15": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "limiterGainQ15": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        },
        "peakQ15": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32768
        }
      }
    },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec",
        "sampleRate",
        "channels",
        "renditions"
      ],
      "properties": {
        "codec": {
          "const": "aac"
        },
        "sampleRate": {
          "const": 48000
        },
        "channels": {
          "const": 2
        },
        "renditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "targetBitsPerSecond"
            ],
            "properties": {
              "id": {
                "enum": [
                  "low",
                  "medium",
                  "high"
                ]
              },
              "targetBitsPerSecond": {
                "type": "integer",
                "minimum": 16000,
                "maximum": 320000
              }
            }
          }
        }
      }
    }
  }
}
