{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/native-packager/source-audio.v1.schema.json",
  "title": "Native audio presentation control; current authenticated owner and explicit director authority required",
  "$comment": "Runtime additionally enforces 16 KiB, freshness, unique sourceLeaseId, current scope, source consent and CAS. A receipt is historical, not renewed authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "type",
    "commandId",
    "assignmentId",
    "programId",
    "programEpoch",
    "leaseId",
    "fencingRevision",
    "issuedAt",
    "expiresAt",
    "expectedAudioRevision",
    "sources"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "const": "source-program-audio"
    },
    "commandId": {
      "type": "string",
      "pattern": "^aud_[A-Za-z0-9_-]{16,64}$"
    },
    "assignmentId": {
      "type": "string",
      "pattern": "^asn_[A-Za-z0-9_-]{16,64}$"
    },
    "programId": {
      "type": "string",
      "pattern": "^prg_[A-Za-z0-9_-]{16,64}$"
    },
    "programEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "leaseId": {
      "type": "string",
      "pattern": "^lea_[A-Za-z0-9_-]{16,64}$"
    },
    "fencingRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "issuedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expectedAudioRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740990
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceLeaseId",
          "leftGainQ15",
          "rightGainQ15",
          "muted"
        ],
        "properties": {
          "sourceLeaseId": {
            "type": "string",
            "pattern": "^sls_[A-Za-z0-9_-]{16,64}$"
          },
          "leftGainQ15": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32768
          },
          "rightGainQ15": {
            "type": "integer",
            "minimum": 0,
            "maximum": 32768
          },
          "muted": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
