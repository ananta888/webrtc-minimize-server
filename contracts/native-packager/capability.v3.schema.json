{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/native-packager/capability.v3.schema.json",
  "title": "Explicit native source-program and audio-control capability v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilityVersion",
    "agentId",
    "tenantId",
    "ownerSubjectRef",
    "deviceRef",
    "agentVersion",
    "ffmpegVersion",
    "videoEncoders",
    "audioEncoders",
    "hardwareClass",
    "cpuClass",
    "gpuClass",
    "uploadClass",
    "energyClass",
    "health",
    "maximumRenditions",
    "maximumPixelsPerSecond",
    "consentedRoomIds",
    "observedAt",
    "expiresAt",
    "sourcePrograms",
    "sourceAudioControlVersion"
  ],
  "properties": {
    "capabilityVersion": {
      "const": 3
    },
    "agentId": {
      "$ref": "#/$defs/packagerId"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^tn_[A-Za-z0-9_-]{16,64}$"
    },
    "ownerSubjectRef": {
      "type": "string",
      "pattern": "^sub_[A-Za-z0-9_-]{16,64}$"
    },
    "deviceRef": {
      "type": "string",
      "pattern": "^dev_[A-Za-z0-9_-]{16,64}$"
    },
    "agentVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,64}$"
    },
    "ffmpegVersion": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._+-]{1,64}$"
    },
    "videoEncoders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "libx264",
          "h264_nvenc",
          "h264_videotoolbox"
        ]
      }
    },
    "audioEncoders": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "const": "aac"
      }
    },
    "hardwareClass": {
      "enum": [
        "small",
        "medium",
        "large"
      ]
    },
    "cpuClass": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "gpuClass": {
      "enum": [
        "none",
        "integrated",
        "dedicated"
      ]
    },
    "uploadClass": {
      "enum": [
        "under-5mbit",
        "5-15mbit",
        "over-15mbit"
      ]
    },
    "energyClass": {
      "enum": [
        "battery",
        "ac-limited",
        "ac"
      ]
    },
    "health": {
      "enum": [
        "healthy",
        "degraded",
        "draining"
      ]
    },
    "maximumRenditions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "maximumPixelsPerSecond": {
      "type": "integer",
      "minimum": 2304000,
      "maximum": 373248000
    },
    "consentedRoomIds": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{4,64}$"
      }
    },
    "observedAt": {
      "type": "integer",
      "minimum": 1
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1
    },
    "sourcePrograms": {
      "const": true
    },
    "sourceAudioControlVersion": {
      "const": 1
    }
  },
  "$defs": {
    "packagerId": {
      "type": "string",
      "pattern": "^pkr_[A-Za-z0-9_-]{16,64}$"
    }
  }
}
