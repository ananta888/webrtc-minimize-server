{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/native-packager/program-history-response.v3.schema.json",
  "title": "Native program history response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "complete",
    "retentionMs",
    "programId",
    "programRevision",
    "programEpoch",
    "observedAt",
    "expiresAt",
    "events"
  ],
  "properties": {
    "version": {
      "const": 3
    },
    "complete": {
      "const": false
    },
    "retentionMs": {
      "const": 900000
    },
    "programId": {
      "type": "string",
      "pattern": "^prg_[A-Za-z0-9_-]{16,64}$"
    },
    "programRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "programEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "observedAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "events": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "state",
          "occurredAt",
          "programRevision",
          "programEpoch",
          "standbyCount",
          "sourceKind",
          "reason",
          "controlRevision"
        ],
        "properties": {
          "kind": {
            "enum": [
              "registered",
              "state-changed",
              "standby-changed",
              "handoff-begun",
              "handoff-assigned",
              "handoff-stopped",
              "source-consented",
              "source-revoked",
              "scene-applied",
              "audio-applied",
              "source-requested",
              "source-request-closed",
              "scene-rejected",
              "audio-rejected"
            ]
          },
          "state": {
            "enum": [
              "draft",
              "preparing",
              "awaiting_consent",
              "publishing",
              "live",
              "degraded",
              "stopping",
              "stopped",
              "failed"
            ]
          },
          "occurredAt": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "programRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "programEpoch": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "standbyCount": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "sourceKind": {
            "enum": [
              null,
              "camera",
              "microphone",
              "screen",
              "screen-audio"
            ]
          },
          "reason": {
            "enum": [
              null,
              "user-revoked",
              "program-owner-removed",
              "expired",
              "lease-lost",
              "destroyed",
              "own-source",
              "invited",
              "declined",
              "cancelled",
              "invalidated"
            ]
          },
          "controlRevision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "oneOf": [
          {
            "properties": {
              "kind": {
                "enum": [
                  "registered",
                  "state-changed",
                  "standby-changed",
                  "handoff-begun",
                  "handoff-assigned",
                  "handoff-stopped"
                ]
              },
              "sourceKind": {
                "type": "null"
              },
              "reason": {
                "type": "null"
              },
              "controlRevision": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "kind": {
                "const": "source-consented"
              },
              "sourceKind": {
                "type": "string"
              },
              "reason": {
                "type": "null"
              },
              "controlRevision": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "kind": {
                "const": "source-revoked"
              },
              "sourceKind": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "user-revoked",
                  "program-owner-removed",
                  "expired",
                  "lease-lost",
                  "destroyed"
                ]
              },
              "controlRevision": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "scene-applied",
                  "audio-applied"
                ]
              },
              "sourceKind": {
                "type": "null"
              },
              "reason": {
                "type": "null"
              },
              "controlRevision": {
                "type": "integer"
              }
            }
          },
          {
            "properties": {
              "kind": {
                "const": "source-requested"
              },
              "sourceKind": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "own-source",
                  "invited"
                ]
              },
              "controlRevision": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "kind": {
                "const": "source-request-closed"
              },
              "sourceKind": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "declined",
                  "cancelled",
                  "invalidated"
                ]
              },
              "controlRevision": {
                "type": "null"
              }
            }
          },
          {
            "properties": {
              "kind": {
                "enum": [
                  "scene-rejected",
                  "audio-rejected"
                ]
              },
              "sourceKind": {
                "type": "null"
              },
              "reason": {
                "type": "null"
              },
              "controlRevision": {
                "type": "null"
              }
            }
          }
        ]
      }
    }
  }
}
