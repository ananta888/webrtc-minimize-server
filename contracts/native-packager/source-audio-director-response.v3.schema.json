{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/native-packager/source-audio-director-response.v3.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioControlVersion",
        "programId",
        "programRevision",
        "programEpoch",
        "packagerId",
        "assignmentId",
        "fencingRevision",
        "outcome",
        "observedAt",
        "audioRevision",
        "sources",
        "mix",
        "encoding"
      ],
      "properties": {
        "audioControlVersion": {
          "const": 3
        },
        "programId": {
          "type": "string",
          "pattern": "^prg_[A-Za-z0-9_-]{16,64}$"
        },
        "programRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "programEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "packagerId": {
          "type": "string",
          "pattern": "^pkr_[A-Za-z0-9_-]{16,64}$"
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^asn_[A-Za-z0-9_-]{16,64}$"
        },
        "fencingRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "outcome": {
          "const": "observed"
        },
        "observedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "audioRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sources": {
          "type": "array",
          "maxItems": 80,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sourceLeaseId",
              "leftGainQ15",
              "rightGainQ15",
              "muted",
              "sourceKind"
            ],
            "properties": {
              "sourceLeaseId": {
                "type": "string",
                "pattern": "^sls_[A-Za-z0-9_-]{16,64}$"
              },
              "leftGainQ15": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32768
              },
              "rightGainQ15": {
                "type": "integer",
                "minimum": 0,
                "maximum": 32768
              },
              "muted": {
                "type": "boolean"
              },
              "sourceKind": {
                "enum": [
                  "microphone",
                  "screen-audio"
                ]
              }
            }
          }
        },
        "mix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "microphoneGainQ15",
            "screenAudioGainQ15",
            "limiterGainQ15",
            "peakQ15"
          ],
          "properties": {
            "strategy": {
              "enum": [
                "unprocessed",
                "balanced",
                "speech-first",
                "screen-first"
              ]
            },
            "microphoneGainQ15": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "screenAudioGainQ15": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "limiterGainQ15": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            },
            "peakQ15": {
              "type": "integer",
              "minimum": 0,
              "maximum": 32768
            }
          }
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "codec",
            "sampleRate",
            "channels",
            "renditions"
          ],
          "properties": {
            "codec": {
              "const": "aac"
            },
            "sampleRate": {
              "const": 48000
            },
            "channels": {
              "enum": [
                1,
                2
              ]
            },
            "renditions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "targetBitsPerSecond"
                ],
                "properties": {
                  "id": {
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "targetBitsPerSecond": {
                    "type": "integer",
                    "minimum": 16000,
                    "maximum": 320000
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioControlVersion",
        "programId",
        "programRevision",
        "programEpoch",
        "packagerId",
        "assignmentId",
        "fencingRevision",
        "outcome",
        "appliedAt",
        "audioRevision"
      ],
      "properties": {
        "audioControlVersion": {
          "const": 3
        },
        "programId": {
          "type": "string",
          "pattern": "^prg_[A-Za-z0-9_-]{16,64}$"
        },
        "programRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "programEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "packagerId": {
          "type": "string",
          "pattern": "^pkr_[A-Za-z0-9_-]{16,64}$"
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^asn_[A-Za-z0-9_-]{16,64}$"
        },
        "fencingRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "outcome": {
          "const": "applied"
        },
        "appliedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "audioRevision": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audioControlVersion",
        "programId",
        "programRevision",
        "programEpoch",
        "packagerId",
        "assignmentId",
        "fencingRevision",
        "outcome",
        "observedAt",
        "reasonCode"
      ],
      "properties": {
        "audioControlVersion": {
          "const": 3
        },
        "programId": {
          "type": "string",
          "pattern": "^prg_[A-Za-z0-9_-]{16,64}$"
        },
        "programRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "programEpoch": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "packagerId": {
          "type": "string",
          "pattern": "^pkr_[A-Za-z0-9_-]{16,64}$"
        },
        "assignmentId": {
          "type": "string",
          "pattern": "^asn_[A-Za-z0-9_-]{16,64}$"
        },
        "fencingRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "outcome": {
          "const": "rejected"
        },
        "observedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "reasonCode": {
          "const": "AUDIO_NOT_APPLIED"
        }
      }
    }
  ]
}
