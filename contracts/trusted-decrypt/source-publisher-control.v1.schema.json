{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/trusted-decrypt/source-publisher-control.v1.schema.json",
  "title": "Source approval and receiver-confirmed publisher lease metadata",
  "$comment": "A local explicit approval and current source/membership binding remain necessary. An approved receipt alone must not start media. No frame keys or plaintext content in these messages.",
  "oneOf": [
    {"type":"object","additionalProperties":false,
      "required":["version","type","roomId","peerId","roomEpoch","publicationRevision","publications"],
      "properties":{"version":{"const":1},"type":{"const":"trusted-source-publications"},
        "roomId":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]{5,47}$"},
        "peerId":{"type":"string","pattern":"^[a-f0-9]{16}$"},"roomEpoch":{"$ref":"#/$defs/positive"},
        "publicationRevision":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "publications":{"type":"array","maxItems":4,"items":{"type":"object","additionalProperties":false,
          "required":["publicationId","source","publicationEpoch"],"properties":{
            "publicationId":{"type":"string","pattern":"^[A-Za-z0-9_={}:-]{1,128}$"},
            "source":{"enum":["microphone","camera","screen","screen-audio"]},"publicationEpoch":{"$ref":"#/$defs/positive"}}}}}},
    {"type":"object","additionalProperties":false,"required":["version","type","requestId","consent"],
      "properties":{"version":{"const":1},"type":{"const":"trusted-source-approved"},
        "requestId":{"type":"string","pattern":"^bsr_[A-Za-z0-9_-]{24}$"},
        "consent":{"$ref":"https://webrtc.ananta.de/contracts/trusted-decrypt/wire.v1.schema.json#/$defs/consent"}}},
    {"type":"object","additionalProperties":false,"required":["version","type","consentId"],
      "properties":{"version":{"const":1},"type":{"const":"trusted-source-revoked"},
        "consentId":{"$ref":"#/$defs/consentId"}}},
    {"type":"object","additionalProperties":false,"required":["version","type","lease"],
      "properties":{"version":{"const":1},"type":{"const":"trusted-source-publisher-lease"},
        "lease":{"$ref":"https://webrtc.ananta.de/contracts/trusted-decrypt/source-lease.v1.schema.json"}}},
    {"type":"object","additionalProperties":false,
      "required":["version","type","sourceLeaseId","leaseRevision","consentId","assignmentId","fencingRevision","expiresAt","reasonCode"],
      "properties":{"version":{"const":1},"type":{"const":"trusted-source-publisher-stop"},
        "sourceLeaseId":{"type":"string","pattern":"^sls_[A-Za-z0-9_-]{16,64}$"},
        "leaseRevision":{"type":"integer","minimum":1,"maximum":1024},"consentId":{"$ref":"#/$defs/consentId"},
        "assignmentId":{"type":"string","pattern":"^asn_[A-Za-z0-9_-]{16,64}$"},
        "fencingRevision":{"$ref":"#/$defs/positive"},"expiresAt":{"$ref":"#/$defs/positive"},
        "reasonCode":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{1,63}$"}}}
  ],
  "$defs": {
    "consentId":{"type":"string","pattern":"^cns_[A-Za-z0-9_-]{16,64}$"},
    "positive":{"type":"integer","minimum":1,"maximum":9007199254740991}
  }
}
