{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/broadcast/common.v1.schema.json",
  "title": "Broadcast common definitions v1",
  "$defs": {
    "contractVersion": {"type": "integer", "const": 1},
    "tenantId": {"type": "string", "pattern": "^tn_[A-Za-z0-9_-]{16,64}$"},
    "subjectRef": {"type": "string", "pattern": "^sub_[A-Za-z0-9_-]{16,64}$"},
    "principalRef": {"type": "string", "pattern": "^(sub|pkr)_[A-Za-z0-9_-]{16,64}$"},
    "roomId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{5,47}$"},
    "programId": {"type": "string", "pattern": "^prg_[A-Za-z0-9_-]{16,64}$"},
    "sourceId": {"type": "string", "pattern": "^src_[A-Za-z0-9_-]{16,64}$"},
    "publicationId": {"type": "string", "pattern": "^pub_[A-Za-z0-9_-]{16,64}$"},
    "renditionId": {"type": "string", "pattern": "^ren_[A-Za-z0-9_-]{16,64}$"},
    "endpointId": {"type": "string", "pattern": "^end_[A-Za-z0-9_-]{16,64}$"},
    "capabilityId": {"type": "string", "pattern": "^cap_[A-Za-z0-9_-]{16,64}$"},
    "consentId": {"type": "string", "pattern": "^cns_[A-Za-z0-9_-]{16,64}$"},
    "leaseId": {"type": "string", "pattern": "^lea_[A-Za-z0-9_-]{16,64}$"},
    "grantId": {"type": "string", "pattern": "^grt_[A-Za-z0-9_-]{16,64}$"},
    "policyId": {"type": "string", "pattern": "^pol_[A-Za-z0-9_-]{16,64}$"},
    "captionTrackId": {"type": "string", "pattern": "^cpt_[A-Za-z0-9_-]{16,64}$"},
    "eventId": {"type": "string", "pattern": "^evt_[A-Za-z0-9_-]{16,64}$"},
    "adapterRef": {"type": "string", "pattern": "^adp_[A-Za-z0-9_-]{16,64}$"},
    "componentRef": {"type": "string", "pattern": "^cmp_[A-Za-z0-9_-]{16,64}$"},
    "peerRef": {"type": "string", "pattern": "^peer_[A-Za-z0-9_-]{16,64}$"},
    "resourceRef": {"type": "string", "pattern": "^res_[A-Za-z0-9_-]{16,64}$"},
    "entityRef": {"type": "string", "pattern": "^(prg|src|pub|ren|end|cap|cns|lea|grt|pol|cpt)_[A-Za-z0-9_-]{16,64}$"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "epoch": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "timestamp": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "protocol": {"enum": ["whip", "rtmps", "srt", "hls", "ll-hls", "whep", "moq", "dash"]},
    "codec": {"enum": ["opus", "aac", "vp8", "vp9", "h264", "av1"]}
  }
}
