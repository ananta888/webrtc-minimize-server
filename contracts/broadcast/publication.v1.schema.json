{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/broadcast/publication.v1.schema.json",
  "title": "Publication v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "type", "tenantId", "subjectRef", "roomId", "programId",
    "publicationId", "revision", "programEpoch", "sourceIds", "mode", "state", "createdAt", "updatedAt"
  ],
  "properties": {
    "contractVersion": {"$ref": "common.v1.schema.json#/$defs/contractVersion"},
    "type": {"const": "publication"},
    "tenantId": {"$ref": "common.v1.schema.json#/$defs/tenantId"},
    "subjectRef": {"$ref": "common.v1.schema.json#/$defs/subjectRef"},
    "roomId": {"$ref": "common.v1.schema.json#/$defs/roomId"},
    "programId": {"$ref": "common.v1.schema.json#/$defs/programId"},
    "publicationId": {"$ref": "common.v1.schema.json#/$defs/publicationId"},
    "revision": {"$ref": "common.v1.schema.json#/$defs/revision"},
    "programEpoch": {"$ref": "common.v1.schema.json#/$defs/epoch"},
    "sourceIds": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "common.v1.schema.json#/$defs/sourceId"}},
    "mode": {"enum": ["own-source", "trusted-program"]},
    "state": {"enum": ["planned", "starting", "live", "stopping", "stopped", "failed"]},
    "leaseId": {"$ref": "common.v1.schema.json#/$defs/leaseId"},
    "capabilityId": {"$ref": "common.v1.schema.json#/$defs/capabilityId"},
    "createdAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"},
    "updatedAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"},
    "endedAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"enum": ["stopped", "failed"]}}, "required": ["state"]},
      "then": {"properties": {"endedAt": {}}, "required": ["endedAt"]}
    }
  ]
}
