{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc.ananta.de/contracts/broadcast/consent.v1.schema.json",
  "title": "Consent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion", "type", "tenantId", "grantorSubjectRef", "roomId", "programId",
    "consentId", "granteeRef", "revision", "programEpoch", "sourceIds", "actions", "status",
    "grantedAt", "expiresAt"
  ],
  "properties": {
    "contractVersion": {"$ref": "common.v1.schema.json#/$defs/contractVersion"},
    "type": {"const": "consent"},
    "tenantId": {"$ref": "common.v1.schema.json#/$defs/tenantId"},
    "grantorSubjectRef": {"$ref": "common.v1.schema.json#/$defs/subjectRef"},
    "roomId": {"$ref": "common.v1.schema.json#/$defs/roomId"},
    "programId": {"$ref": "common.v1.schema.json#/$defs/programId"},
    "consentId": {"$ref": "common.v1.schema.json#/$defs/consentId"},
    "granteeRef": {"$ref": "common.v1.schema.json#/$defs/principalRef"},
    "revision": {"$ref": "common.v1.schema.json#/$defs/revision"},
    "programEpoch": {"$ref": "common.v1.schema.json#/$defs/epoch"},
    "sourceIds": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "common.v1.schema.json#/$defs/sourceId"}},
    "actions": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["decrypt-source", "compose-program", "publish-program"]}},
    "status": {"enum": ["active", "revoked", "expired"]},
    "grantedAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"},
    "expiresAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"},
    "revokedAt": {"$ref": "common.v1.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "revoked"}}, "required": ["status"]},
      "then": {"properties": {"revokedAt": {}}, "required": ["revokedAt"]},
      "else": {"not": {"properties": {"revokedAt": {}}, "required": ["revokedAt"]}}
    }
  ]
}
