# Root-only environment for ananta-turn-tls-sync.service.
TURN_TLS_SOURCE_CERT=/var/lib/docker/volumes/ananta-public_public_caddy_data/_data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/webrtc.ananta.de/webrtc.ananta.de.crt
TURN_TLS_SOURCE_KEY=/var/lib/docker/volumes/ananta-public_public_caddy_data/_data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/webrtc.ananta.de/webrtc.ananta.de.key
TURN_TLS_TARGET_DIR=/etc/ananta/turn-tls
TURN_TLS_SERVER_NAME=webrtc.ananta.de
TURN_TLS_MIN_VALID_SECONDS=604800
TURN_TLS_SOURCE_UID=0
TURN_TLS_TARGET_UID=0
TURN_TLS_TARGET_GID=10002
TURN_TLS_RESTART_ENABLED=1
TURN_TLS_COMPOSE_PROJECT=ananta-public
TURN_TLS_COMPOSE_SERVICE=coturn
