    "control-plane-restart",
    "provider-failure",
    "dns-failure",
    "tls-failure",
    "expired-grant",
    "network-partition",
    "split-brain-attempt"
  ],
  "budgets": {
    "originErrorRatioMax": 0,
    "originP95RequestLatencyMsMax": 2500,
    "recoveryDeadlineMsMax": 20000,
    "cleanupDeadlineMsMax": 40000,
    "ssimAllMin": 0.95
  },
  "costInputs": {
    "computeCurrencyPerHour": null,
    "gpuCurrencyPerHour": null,
    "egressCurrencyPerGb": null,
    "cdnCurrencyPerGb": null,
    "observabilityCurrencyPerGb": null,
    "storageCurrencyPerGbMonth": null
  }
