HOST=0.0.0.0
PORT=8080
# Set this in production to the exact HTTPS origin, e.g. https://call.example.org
PUBLIC_ORIGIN=http://localhost:8080
AUTH_MODE=required
OIDC_ISSUER=http://localhost:8081/realms/webrtc
# Container-internal JWKS URL; the issuer above remains the verified token issuer.
OIDC_JWKS_URL=http://keycloak:8080/realms/webrtc/protocol/openid-connect/certs
OIDC_AUDIENCE=webrtc-room-server
OIDC_CLIENT_ID=webrtc-browser
OIDC_JWKS_CACHE_MS=300000
SESSION_TICKET_TTL_MS=30000
DEVICE_PROOF_MAX_AGE_MS=60000
STUN_URLS=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# Local-only example. Generate a strong independent secret before any shared deployment.
TURN_SHARED_SECRET=local-development-only-change-me
TURN_REALM=webrtc.local
TURN_EXTERNAL_IP=127.0.0.1
TURN_CREDENTIAL_TTL_MS=600000
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
KEYCLOAK_PORT=8081
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-development-only-change-me
MAX_ROOM_PARTICIPANTS=20
ROOM_IDLE_TTL_MS=3600000
SIGNAL_RATE_LIMIT=120
# Operator policy permits relay selection, but every browser still starts with relay consent off.
PEER_MEDIA_RELAY_ENABLED=true
PEER_MEDIA_RELAY_MIN_PARTICIPANTS=6
PEER_MEDIA_RELAY_MAX_CHILDREN=3
PEER_MEDIA_RELAY_MAX_HOPS=3
ACTIVE_SPEAKER_LIMIT=5
