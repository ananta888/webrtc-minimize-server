HOST=0.0.0.0
PORT=8080
# Set this in production to the exact HTTPS origin, e.g. https://call.example.org
PUBLIC_ORIGIN=
STUN_URLS=stun:stun.l.google.com:19302
# JSON array; prefer short-lived TURN credentials in production.
TURN_SERVERS_JSON=[]
MAX_ROOM_PARTICIPANTS=20
ROOM_IDLE_TTL_MS=3600000
SIGNAL_RATE_LIMIT=120
