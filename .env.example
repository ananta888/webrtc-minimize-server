# Public Ananta preset. Copy to .env and replace PUBLIC_ORIGIN and
# KEYCLOAK_ORIGIN to use two domains controlled by another operator.
HOST=0.0.0.0
PORT=8080
PUBLIC_ORIGIN=https://webrtc.ananta.de
AUTH_MODE=required
KEYCLOAK_ORIGIN=https://keycloak.ananta.de
KEYCLOAK_REALM=ananta
# Advanced override: when set, OIDC_ISSUER takes precedence over the two
# Keycloak shortcut variables above. Empty JWKS derives from the exact issuer.
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUDIENCE=webrtc-room-server
OIDC_CLIENT_ID=webrtc-browser
OIDC_JWKS_CACHE_MS=300000
SESSION_TICKET_TTL_MS=30000
DEVICE_PROOF_MAX_AGE_MS=60000
STUN_URLS=stun:stun.l.google.com:19302
# Configure both TURN values together. Keep both empty when no compatible
# Coturn REST shared-secret service is available.
TURN_URLS=
TURN_SHARED_SECRET=
TURN_REALM=webrtc.ananta.de
TURN_CREDENTIAL_TTL_MS=600000
# Optional volunteer Edge-TURN nodes. This JSON and every sharedSecret stay
# server-side. Never copy an agent secret into browser code or version control.
EDGE_TURN_SERVERS_JSON=
PEER_EDGE_FALLBACK_MS=4000
INFRASTRUCTURE_TURN_FALLBACK_MS=9000
# required is fail-closed. preferred visibly falls back only on browsers without
# Encoded Transform support; disabled enables the legacy decode/re-encode relay.
MEDIA_E2EE_MODE=required
# Optional operator-bound blind media agents. Each object contains exactly
# id, ownerPrincipal (exact issuer|subject) and a 32-512 character secret.
# Keep the JSON server-side and use the same secret only in the native agent.
MEDIA_EDGE_AGENTS_JSON=
MEDIA_AGENT_LEASE_MS=30000
MEDIA_AGENT_RENEW_MS=10000
MEDIA_AGENT_MAX_STANDBYS=2
# Ein geeigneter einzelner Agent spart ab drei Teilnehmern Zielkopien.
MEDIA_AGENT_MIN_PARTICIPANTS=3
# Mehrere Forwarder und Agent-Foederation bleiben groesseren Raeumen vorbehalten.
MEDIA_AGENT_SHARD_MIN_PARTICIPANTS=6
MEDIA_AGENT_TAKEOVER_TTL_MS=20000
MEDIA_AGENT_RATE_LIMIT=2000
MEDIA_AGENT_SELF_SERVICE_ENABLED=true
MEDIA_AGENT_REGISTRATION_DB=/app/data/media-agent-registrations.sqlite
MEDIA_AGENT_ARTIFACT_DIR=/app/media-agent-downloads
MEDIA_AGENT_ENROLLMENT_TTL_MS=600000
MEDIA_AGENT_MAX_PER_PRINCIPAL=3
MEDIA_AGENT_ENROLLMENT_RATE_LIMIT=5
MAX_ROOM_PARTICIPANTS=20
ROOM_IDLE_TTL_MS=3600000
SIGNAL_RATE_LIMIT=300
# Operator policy permits relay selection, but every browser starts with relay consent off.
# A tree is emitted only when maxChildren is smaller than the direct N-1 fanout.
PEER_MEDIA_RELAY_ENABLED=true
PEER_MEDIA_RELAY_MIN_PARTICIPANTS=3
PEER_MEDIA_RELAY_MAX_CHILDREN=3
PEER_MEDIA_RELAY_MAX_HOPS=3
PEER_ROUTE_LEASE_MS=60000
PEER_ROUTE_RENEW_MS=25000
PEER_RELAY_HEALTH_WINDOW_MS=30000
PEER_RELAY_HEALTH_COOLDOWN_MS=60000
PEER_DATA_OVERLAY_ENABLED=true
# Nur Workspace-Metadaten/Events, niemals Medien. Auf ein gesichertes Volume legen.
PAIR_WORKSPACE_ENABLED=true
PAIR_WORKSPACE_DB=/app/data/pair-workspaces.sqlite
ACTIVE_SPEAKER_LIMIT=5
# Optional browser WHIP ingest. Keep the endpoint empty until an HTTPS gateway
# and the short-lived, action-bound grant endpoint are both deployed. Never put
# a stream key or bearer token in this URL or any versioned file.
BROADCAST_WHIP_ENDPOINT=
# Strict RFC mode is the default. mediamtx-1.20 explicitly accepts that pinned
# gateway's wildcard ETag/missing answer attribute and disables ICE restart.
BROADCAST_WHIP_PROFILE=rfc9725
BROADCAST_WHIP_REDIRECT_ORIGINS=
BROADCAST_WHIP_TRICKLE_ICE=true
BROADCAST_WHIP_AUDIO_CODECS=audio/opus
BROADCAST_WHIP_VIDEO_CODECS=video/vp8,video/h264
BROADCAST_WHIP_REQUEST_TIMEOUT_MS=8000
BROADCAST_WHIP_ICE_GATHERING_TIMEOUT_MS=10000
BROADCAST_WHIP_CONNECTION_TIMEOUT_MS=20000
BROADCAST_WHIP_RETRY_BUDGET=1
