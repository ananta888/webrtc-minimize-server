{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webrtc-minimize.local/schemas/todo.track.schema.json",
  "title": "WebRTC Minimize Task Track Todo Schema",
  "type": "object",
  "additionalProperties": true,
  "required": ["version", "owner", "track", "status_scale", "priority_scale", "risk_scale", "milestones", "tasks", "tasks_status_summary"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "anyOf": [{ "type": "integer" }, { "type": "string", "minLength": 1 }] },
    "owner": { "type": "string", "minLength": 1 },
    "track": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string" },
    "goal": { "type": "string" },
    "status": { "type": "string" },
    "status_scale": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "priority_scale": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risk_scale": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "milestones": { "type": "array", "items": { "$ref": "#/$defs/milestone" } },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
    "critical_path_tasks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "tasks_status_summary": { "$ref": "#/$defs/tasksStatusSummary" },
    "progress_summary": { "$ref": "#/$defs/progressSummary" },
    "summary_notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "milestone": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "task_ids", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "task_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "status": { "enum": ["todo", "in_progress", "blocked", "done"] }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "status", "priority", "risk", "acceptance_criteria"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["todo", "in_progress", "partial", "blocked", "done"] },
        "priority": { "enum": ["P0", "P1", "P2", "P3"] },
        "risk": { "enum": ["low", "medium", "high", "critical"] },
        "progress_percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "depends_on": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "tasksStatusSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total", "by_status", "progress_percent_done", "by_priority", "by_risk", "critical_path", "milestones"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_status": {
          "type": "object",
          "additionalProperties": false,
          "required": ["todo", "in_progress", "partial", "blocked", "done"],
          "properties": {
            "todo": { "type": "integer", "minimum": 0 },
            "in_progress": { "type": "integer", "minimum": 0 },
            "partial": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "done": { "type": "integer", "minimum": 0 }
          }
        },
        "progress_percent_done": { "type": "number", "minimum": 0, "maximum": 100 },
        "by_priority": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "by_risk": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "critical_path": {
          "type": "object",
          "required": ["total", "done", "remaining"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "done": { "type": "integer", "minimum": 0 },
            "remaining": { "type": "integer", "minimum": 0 }
          }
        },
        "milestones": {
          "type": "object",
          "required": ["total", "todo", "in_progress", "blocked", "done"],
          "properties": {
            "total": { "type": "integer", "minimum": 0 },
            "todo": { "type": "integer", "minimum": 0 },
            "in_progress": { "type": "integer", "minimum": 0 },
            "blocked": { "type": "integer", "minimum": 0 },
            "done": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "progressSummary": {
      "type": "object",
      "additionalProperties": true,
      "required": ["state", "todo_remaining", "in_progress", "partial", "blocked", "done"],
      "properties": {
        "state": { "type": "string", "minLength": 1 },
        "todo_remaining": { "type": "integer", "minimum": 0 },
        "in_progress": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "done": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
