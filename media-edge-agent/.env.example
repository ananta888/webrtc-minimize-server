MEDIA_AGENT_SIGNAL_URL=wss://webrtc.ananta.de/media-agent
MEDIA_AGENT_ID=laptop-edge
# Must exactly match the server-side MEDIA_EDGE_AGENTS_JSON entry. Never commit it.
MEDIA_AGENT_SHARED_SECRET=replace-with-at-least-32-random-characters
# Self-service agents use MEDIA_AGENT_IDENTITY_FILE instead. Configure exactly one
# authentication method; the short-lived enrollment token is used only by
# `media-edge-agent enroll` and must not remain in a service environment.
# MEDIA_AGENT_IDENTITY_FILE=/var/lib/ananta-media-agent/identity.pem
# MEDIA_AGENT_ENROLLMENT_TOKEN=
# 0 uses normal ephemeral ICE sockets. A fixed port is optional and can be
# forwarded by the router when direct reachability is desired.
MEDIA_AGENT_UDP_PORT=0
MEDIA_AGENT_LISTEN_IP=0.0.0.0
MEDIA_AGENT_PUBLIC_IP=
MEDIA_AGENT_TLS_CA_FILE=
MEDIA_AGENT_MAX_ROOMS=8
MEDIA_AGENT_MAX_PEERS=20
MEDIA_AGENT_MAX_TRACKS=80
MEDIA_AGENT_MAX_PACKET_BYTES=2048
MEDIA_AGENT_TRACK_QUEUE=128
MEDIA_AGENT_MAX_ROOM_BITRATE_BPS=50000000
MEDIA_AGENT_CAPACITY=70
MEDIA_AGENT_LOAD=0
MEDIA_AGENT_BATTERY=unknown
MEDIA_AGENT_NETWORK=unknown
MEDIA_AGENT_HEARTBEAT_SECONDS=5
