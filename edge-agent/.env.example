# Copy to .env on the voluntary Edge machine. Never commit the resulting file.
EDGE_AGENT_PUBLIC_IP=203.0.113.10
EDGE_AGENT_LISTEN_IP=0.0.0.0
EDGE_AGENT_PORT=3478
EDGE_AGENT_RELAY_MIN_PORT=49160
EDGE_AGENT_RELAY_MAX_PORT=49259
EDGE_AGENT_REALM=webrtc.ananta.de
EDGE_AGENT_SHARED_SECRET=replace-with-at-least-32-random-characters
EDGE_AGENT_MAX_CREDENTIAL_TTL_SECONDS=900
EDGE_AGENT_ALLOCATION_TTL_SECONDS=600
EDGE_AGENT_MAX_ALLOCATIONS=64
EDGE_AGENT_MAX_USER_ALLOCATIONS=4
EDGE_AGENT_ENABLE_TCP=true
EDGE_AGENT_ALLOW_PRIVATE_PEERS=false
# Optional, explicit PCP self-mapping for a native host behind a compatible
# residential router. Keep empty in bridged Docker/WSL networks.
EDGE_AGENT_PCP_GATEWAY=
EDGE_AGENT_PCP_LIFETIME_SECONDS=7200
