{
  "name": "webrtc-minimize-server",
  "version": "0.1.0",
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "description": "Room-based WebRTC mesh for camera, microphone, screen sharing and peer chat.",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "todos:validate": "node scripts/validate-todos.mjs",
    "workflows:validate": "node scripts/validate-workflows.mjs",
    "check": "npm run todos:validate && npm run workflows:validate && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "yaml": "^2.9.0"
  }
}
